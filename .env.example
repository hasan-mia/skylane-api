# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true

# Database (PostgreSQL, MySQL, or MongoDB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skylane?schema=public
DATABASE_PROVIDER=postgresql

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Duffel API
DUFFEL_ACCESS_TOKEN=your-duffel-access-token
DUFFEL_WEBHOOK_SECRET=your-duffel-webhook-secret
DUFFEL_ENVIRONMENT=test

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL=900000
THROTTLE_AUTH_LIMIT=5

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true